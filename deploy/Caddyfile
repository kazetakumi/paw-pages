# The admin API defaults to 127.0.0.1:2019 for every Caddy instance and that
# is not a per-site setting -- only global. This box runs one Caddy per app as
# a separate service, so whichever starts second loses the race for 2019 and
# crash-loops forever. Nothing here ever calls the admin API (every config
# change goes through a full service restart, not `caddy reload`), so it is
# off rather than moved to a port some other app's Caddyfile might also pick.
{
	admin off
}

# Cloudflare terminates TLS at its edge and cloudflared dials out from here, so
# this listens on plain HTTP. Bound to loopback so the only way in is the
# tunnel -- without it the app is also served unencrypted to the whole LAN.
# Run it from the repo root so `web/dist` resolves the same way on Linux later.
:8080 {
	bind 127.0.0.1

	# Backstop for Cloudflare's "Always Use HTTPS". The session cookie is Secure,
	# so a page served over plain http drops it and sign-in fails silently -- and
	# once the edge redirects that page's /api calls, they turn cross-origin and
	# die on CORS. Cloudflare says which scheme the visitor used; a request that
	# came in without the header is the tunnel or a local probe, and is left alone.
	@insecure header X-Forwarded-Proto http
	redir @insecure https://{host}{uri} permanent

	handle_path /api/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle {
		root * web/dist
		try_files {path} /index.html
		file_server
	}

	encode gzip
}
