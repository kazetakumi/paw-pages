SUPABASE_URL=https://hhbrylznsguxemafzgjn.supabase.co
SUPABASE_ANON_KEY=<anon key>

OPENAI_API_KEY=<openai api key>

# kaze-master hosts pawpages_* alongside other apps' tables (see CONTEXT.md
# rule 9) -- there is no separate paw-pages project anymore.
DATABASE_URL=<connection string for the kaze-master project>

# Fernet key sealing the Supabase token pair inside the session cookie.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOKIE_SECRET=<fernet key>
COOKIE_NAME=pawpages_session
COOKIE_DOMAIN=

FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO
