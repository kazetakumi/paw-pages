SUPABASE_URL=https://oomzhjujlztfazvvsfrf.supabase.co
SUPABASE_ANON_KEY=<anon key>
# Used by DELETE /me only, to delete the auth user. Leave unset and account
# deletion answers 503 without touching anything.
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=<openai api key>
# Multiplier on a chat turn's OpenAI cost when charging credits. 1.0 = at cost.
CREDIT_MARKUP=1.0

# kaze-master-in hosts pawpages_* alongside other apps' tables (see CONTEXT.md
# rule 9) -- there is no separate paw-pages project anymore.
DATABASE_URL=<connection string for the kaze-master-in project>

# Fernet key sealing the Supabase token pair inside the session cookie.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOKIE_SECRET=<fernet key>
COOKIE_NAME=pawpages_session
COOKIE_DOMAIN=

FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO
